#!/usr/bin/env python3
"""A fake AWS CLI for the demo: made-up accounts, clusters and instances, no network."""
import json, os, pathlib, sys, time

args = sys.argv[1:]
state = pathlib.Path(os.environ['AWSHOP_DEMO_STATE'])
ACCOUNTS = {'platform-dev': '111111111111', 'platform-staging': '222222222222', 'platform-prod': '333333333333',
            'data-dev': '444444444444', 'data-prod': '555555555555', 'sandbox': '666666666666'}
CLUSTERS = {'platform-dev': ['payments-dev', 'platform-dev'], 'platform-prod': ['payments-prod', 'platform-prod'],
            'platform-staging': ['platform-staging'], 'data-dev': ['analytics-dev'], 'data-prod': ['analytics-prod']}

def value(flag):
    return args[args.index(flag) + 1] if flag in args else ''

profile = value('--profile') or os.environ.get('AWS_PROFILE', '')
command = args[:2]
if command == ['sts', 'get-caller-identity']:
    if not (state / 'logged-in').exists():
        print('Error loading SSO Token: Token for demo does not exist', file=sys.stderr)
        sys.exit(255)
    account = ACCOUNTS.get(profile, '111111111111')
    print(json.dumps({'Account': account, 'Arn': f'arn:aws:sts::{account}:assumed-role/AdministratorAccess/demo'}))
elif command == ['sso', 'login']:
    print('Attempting to automatically open the SSO authorization page in your default browser.')
    time.sleep(1.2)
    print('Successfully logged into Start URL: https://example.awsapps.com/start')
    (state / 'logged-in').touch()
elif command == ['eks', 'list-clusters']:
    time.sleep(0.4)
    print(json.dumps({'clusters': CLUSTERS.get(profile, [])}))
elif command == ['eks', 'update-kubeconfig']:
    time.sleep(0.5)
    path = pathlib.Path(value('--kubeconfig'))
    path.parent.mkdir(parents=True, exist_ok=True)
    alias, region, name = value('--alias'), value('--region'), value('--name')
    arn = f'arn:aws:eks:{region}:{ACCOUNTS.get(profile, "111111111111")}:cluster/{name}'
    path.write_text(json.dumps({'current-context': alias,
        'contexts': [{'name': alias, 'context': {'cluster': arn, 'user': alias}}],
        'users': [{'name': alias, 'user': {'exec': {'args': [], 'env': [{'name': 'AWS_PROFILE', 'value': profile}]}}}]}, indent=2))
    print(f'Updated context {alias} in {path}')
elif command == ['eks', 'describe-cluster']:
    name = value('--name')
    versions = {'payments-dev': '1.33', 'platform-dev': '1.32', 'payments-prod': '1.33', 'platform-prod': '1.32'}
    print(json.dumps({'cluster': {'name': name, 'version': versions.get(name, '1.31'), 'status': 'ACTIVE'}}))
elif command == ['ssm', 'describe-instance-information']:
    time.sleep(0.4)
    print(json.dumps({'InstanceInformationList': [
        {'InstanceId': 'i-0a1b2c3d4e5f60718', 'ResourceType': 'EC2Instance', 'PingStatus': 'Online', 'PlatformName': 'Amazon Linux', 'IPAddress': '10.20.1.14'},
        {'InstanceId': 'i-0f9e8d7c6b5a40312', 'ResourceType': 'EC2Instance', 'PingStatus': 'Online', 'PlatformName': 'Amazon Linux', 'IPAddress': '10.20.2.31'},
        {'InstanceId': 'i-07c6d5e4f3a2b1908', 'ResourceType': 'EC2Instance', 'PingStatus': 'Online', 'PlatformName': 'Ubuntu', 'IPAddress': '10.20.3.7'}]}))
elif command == ['ec2', 'describe-instances']:
    names = {'i-0a1b2c3d4e5f60718': 'web-1', 'i-0f9e8d7c6b5a40312': 'web-2', 'i-07c6d5e4f3a2b1908': 'bastion'}
    instances = [{'InstanceId': i, 'Tags': [{'Key': 'Name', 'Value': n}]} for i, n in names.items()]
    print(json.dumps({'Reservations': [{'Instances': instances}]}))
elif command == ['ssm', 'start-session']:
    # A tiny stand-in for the remote shell.
    target = value('--target')
    print(f'\nStarting session with SessionId: demo-{target[-6:]}')
    replies = {'hostname': 'ip-10-20-1-14.eu-north-1.compute.internal', 'whoami': 'ssm-user',
               'uptime': ' 14:02:11 up 12 days,  3:41,  0 users,  load average: 0.08, 0.05, 0.01'}
    while True:
        sys.stdout.write('sh-5.2$ ')
        sys.stdout.flush()
        line = sys.stdin.readline()
        if not line or line.strip() == 'exit':
            print('\n\nExiting session with sessionId: demo-' + target[-6:] + '.\n')
            break
        if line.strip():
            print(replies.get(line.strip(), f'sh: {line.strip()}: command not found'))
else:
    print('Unsupported in the demo: ' + ' '.join(args), file=sys.stderr)
    sys.exit(2)
