#!/usr/bin/env python3
"""A fake kubectl for the demo: reads kubeconfig files and lists made-up nodes."""
import json, os, pathlib, sys

args = sys.argv[1:]
if args[:2] == ['config', 'view']:
    paths = [args[args.index('--kubeconfig') + 1]] if '--kubeconfig' in args else os.environ.get('KUBECONFIG', '').split(':')
    view = {'current-context': '', 'contexts': [], 'users': []}
    for path in map(pathlib.Path, filter(None, paths)):
        if path.exists():
            config = json.loads(path.read_text())
            view['current-context'] = view['current-context'] or config.get('current-context', '')
            view['contexts'] += config.get('contexts', [])
            view['users'] += config.get('users', [])
    print(json.dumps(view))
elif args[:2] == ['get', 'nodes']:
    print('NAME                                          STATUS   ROLES    AGE   VERSION')
    for index, zone in enumerate(['a', 'b', 'c']):
        print(f'ip-10-20-{index + 4}-{11 + index * 7}.eu-north-1.compute.internal   Ready    <none>   9d    v1.31.4-eks-0f56d01')
else:
    print('Unsupported in the demo: kubectl ' + ' '.join(args), file=sys.stderr)
    sys.exit(2)
